PORT=5000
# Put a rotated Atlas URI here in server/.env. Never commit that file.
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:5173
# Optional production frontend origin for cross-origin access. Same-domain Vercel rewrites do not require this.
FRONTEND_URL=
NODE_ENV=development
# Enable only when intentionally running the local, in-memory demo.
ALLOW_IN_MEMORY_FALLBACK=false
# Use a long random value in production.
CAPTCHA_SECRET=
